---
import Base from "@/layouts/Base.astro";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => {
    const cleanId = post.id.replace(/\.mdx?$/, "");
    const finalSlug = cleanId.split("/").pop();

    return {
      params: { slug: finalSlug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = post.data?.date
  ? new Date(post.data.date).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "Recent";
---

<Base title={post.data.title} description={post.data.description}>
  <section class="border-b border-gray-200 bg-[#f8f9fa] py-12 md:py-20">
    <div class="mx-auto max-w-300 px-6">
      <div
        class="mb-8 flex flex-wrap items-center gap-3 text-sm font-medium text-gray-500"
        data-aos="fade-right">
        <a
          href="/"
          data-astro-prefetch="hover"
          class="transition-colors hover:text-[#2563eb]">
          <i class="fa-solid fa-house mr-1"></i> Home
        </a>
        <i class="fa-solid fa-chevron-right text-[10px] text-gray-300"></i>
        <a
          href="/blog/"
          data-astro-prefetch="hover"
          class="transition-colors hover:text-[#2563eb]">
          Blog
        </a>
        <i class="fa-solid fa-chevron-right text-[10px] text-gray-300"></i>
        <span class="max-w-50 truncate text-[#0f172a] lg:max-w-md">
          {post.data.title}
        </span>
      </div>

      <div class="text-left" data-aos="fade-up">
        {
          post.data.category && (
            <span class="mb-5 inline-block rounded-full bg-[#eff6ff] px-4 py-1.5 text-sm font-bold tracking-widest text-[#2563eb] uppercase">
              {post.data.category}
            </span>
          )
        }
        <h1
          class="mb-6 text-3xl leading-[1.2] font-bold tracking-tight text-[#0f172a] md:text-5xl">
          {post.data.title}
        </h1>
        <div
          class="flex items-center gap-5 border-t border-gray-200 pt-5 text-sm font-bold text-gray-400">
          <span class="flex items-center gap-2">
            <i class="fa-regular fa-calendar text-lg text-[#2563eb]"></i>
            {formattedDate}
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-12 md:py-20">
    <div class="mx-auto max-w-300 px-6">
      <div class="flex flex-col gap-10 lg:flex-row xl:gap-14">
        <main class="min-w-0 flex-1">
          {
            post.data.image && (
              <div
                class="mb-10 w-full overflow-hidden rounded-3xl shadow-xl"
                data-aos="fade-up">
                <OptimizedImage
                  src={post.data.image}
                  alt={post.data.title}
                  class="h-auto max-h-125 w-full object-cover"
                  width={1000}
                  height={500}
                />
              </div>
            )
          }

          {
            headings.length > 0 && (
              <div
                class="mb-10 block rounded-2xl border border-gray-100 bg-[#f8f9fa] p-6 shadow-sm lg:hidden"
                data-aos="fade-up">
                <h3 class="mb-4 text-lg font-bold text-[#0f172a]">
                  On this page
                </h3>
                <ul class="space-y-3 text-sm font-medium text-gray-500">
                  {headings
                    .filter((h: any) => h.depth <= 2)
                    .map((h: any) => (
                      <li>
                        <a
                          href={`#${h.slug}`}
                          class="block border-l-2 border-transparent pl-3 transition-colors hover:border-[#2563eb] hover:text-[#2563eb]">
                          {h.text}
                        </a>
                      </li>
                    ))}
                </ul>
              </div>
            )
          }

          <div
            class="prose prose-lg prose-headings:text-[#0f172a] prose-headings:font-bold prose-a:text-[#2563eb] hover:prose-a:text-[#1d4ed8] prose-img:rounded-2xl max-w-none">
            <Content />
          </div>

          <div
            class="mt-16 flex flex-col items-start justify-between gap-6 border-t border-gray-100 pt-8 sm:flex-row sm:items-center">
            <div class="flex flex-wrap items-center gap-2">
              <span class="mr-2 text-sm font-bold text-[#0f172a]">Tags:</span>
              <span
                class="inline-block cursor-pointer rounded-md bg-gray-100 px-3 py-1 text-xs font-bold text-gray-600 transition-colors hover:bg-gray-200">
                Insulation Material
              </span>
              <span
                class="inline-block cursor-pointer rounded-md bg-gray-100 px-3 py-1 text-xs font-bold text-gray-600 transition-colors hover:bg-gray-200">
                B2B Sourcing
              </span>
            </div>

            <div class="flex items-center gap-3">
              <span class="mr-2 text-sm font-bold text-[#0f172a]">Share:</span>
              <a
                href="https://www.linkedin.com/shareArticle?mini=true"
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-all hover:-translate-y-1 hover:bg-[#0A66C2] hover:text-white"
                aria-label="Share on LinkedIn">
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 fill-current"
                  xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z">
                  </path>
                </svg>
              </a>

              <a
                href="https://www.facebook.com/sharer/sharer.php?u="
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-all hover:-translate-y-1 hover:bg-[#1877F2] hover:text-white"
                aria-label="Share on Facebook">
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 fill-current"
                  xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z">
                  </path>
                </svg>
              </a>
            </div>
          </div>
        </main>

        <aside class="w-full shrink-0 lg:w-85">
          <div class="sticky top-24 space-y-8">
            {
              headings.length > 0 && (
                <div class="hidden rounded-2xl border border-gray-100 bg-white p-6 shadow-sm lg:block">
                  <h3 class="mb-4 text-lg font-bold text-[#0f172a]">
                    On this page
                  </h3>
                  <ul class="space-y-3 text-sm font-medium text-gray-500">
                    {headings
                      .filter((h: any) => h.depth <= 2)
                      .map((h: any) => (
                        <li>
                          <a
                            href={`#${h.slug}`}
                            class="block border-l-2 border-transparent pl-3 transition-colors hover:border-[#2563eb] hover:text-[#2563eb]">
                            {h.text}
                          </a>
                        </li>
                      ))}
                  </ul>
                </div>
              )
            }

            <div
              class="rounded-2xl border border-gray-100 bg-[#f8f9fa] p-6 shadow-sm">
              <h3
                class="mb-5 border-b border-gray-200 pb-3 text-lg font-bold text-[#0f172a]">
                Featured Categories
              </h3>

              <div class="space-y-6">
                <a href="/products/glass-wool-felt/" class="group block">
                  <div
                    class="mb-3 h-40 w-full overflow-hidden rounded-xl bg-gray-200">
                    <img
                      src="/src/assets/images/Glass-Wool-Menu1.png"
                      alt="Glass Wool"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                    />
                  </div>
                  <h4
                    class="truncate text-lg font-bold text-[#0f172a] transition-colors group-hover:text-[#2563eb]">
                    Glass Wool Blanket
                  </h4>
                </a>

                <a href="/products/rubber-plastic-pipe/" class="group block">
                  <div
                    class="mb-3 h-40 w-full overflow-hidden rounded-xl bg-gray-200">
                    <img
                      src="/src/assets/images/Rubber-Plastic-Menu1.png"
                      alt="Rubber Pipe"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                    />
                  </div>
                  <h4
                    class="truncate text-lg font-bold text-[#0f172a] transition-colors group-hover:text-[#2563eb]">
                    Rubber Pipe Insulation
                  </h4>
                </a>
              </div>
            </div>

            <div class="rounded-2xl bg-[#0f172a] p-7 text-white shadow-xl">
              <h3 class="mb-2 text-xl font-bold text-white">Partner With Us</h3>
              <form action="/contact" method="POST" class="mt-6 space-y-4">
                <input
                  type="text"
                  placeholder="Your Name"
                  class="w-full rounded-lg border border-gray-700 bg-gray-800 p-3 text-sm text-white focus:border-[#2563eb] focus:outline-none"
                  required
                />
                <input
                  type="email"
                  placeholder="Email Address"
                  class="w-full rounded-lg border border-gray-700 bg-gray-800 p-3 text-sm text-white focus:border-[#2563eb] focus:outline-none"
                  required
                />
                <textarea
                  placeholder="How can we help?"
                  rows="3"
                  class="w-full resize-none rounded-lg border border-gray-700 bg-gray-800 p-3 text-sm text-white focus:border-[#2563eb] focus:outline-none"
                  required>
                </textarea>
                <button
                  type="submit"
                  class="w-full rounded-lg bg-[#2563eb] py-3 text-sm font-bold text-white transition-colors hover:bg-[#1d4ed8]">
                  Get Quote
                </button>
              </form>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
