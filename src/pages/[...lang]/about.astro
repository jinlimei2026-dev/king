---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import config from ".astro/config.generated.json";
import { render } from "astro:content";
import AboutHero from "@/components/sections/AboutHero.astro";
import AboutIntro from "@/components/sections/AboutIntro.astro";
import AboutHistory from "@/components/sections/AboutHistory.astro";
import AboutManufacturingQC from "@/components/sections/AboutManufacturingQC.astro";
import AboutTeam from "@/components/sections/AboutTeam.astro";
import AboutCTA from "@/components/sections/AboutCTA.astro";
import CertificationsHero from "@/components/sections/CertificationsHero.astro";
import CertificationsDetails from "@/components/sections/CertificationsDetails.astro";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang: any) => {
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;

      const pageData: any = await getEntryCTM(
        "about" as any,
        "-index",
        lang.languageCode,
      );

      return {
        params: {
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
        },
        props: {
          pageData,
        },
      };
    }),
  );

  return paths.flat();
}

const { pageData } = Astro.props;
const { Content } = await render(pageData);
---

<Base {...pageData.data}>
  {(<AboutHero />)}
  {(<AboutIntro />)}
  {(<AboutHistory />)}
  {(<AboutManufacturingQC />)}
  {(<AboutTeam />)}
  {(<AboutCTA />)}
  {(<CertificationsHero />)}
  {(<CertificationsDetails />)}
</Base>
