---
import Base from "@/layouts/Base.astro";
import ContactForm from "@/components/widgets/ContactForm.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";

export async function getStaticPaths() {
  return [{ params: { lang: undefined } }];
}

let contactContent = (
  await getEntryCTM("sections", "contact-section", Astro.currentLocale)
)?.data;

let form = contactContent?.form;
---

<Base
  title="Contact Us"
  description="Get in touch with us for B2B partnerships and inquiries.">
  <section class="border-b border-gray-200 bg-[#f8f9fa] py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-6 text-center">
      <h1
        class="mb-6 text-4xl font-bold tracking-tight text-[#0f172a] md:text-5xl lg:text-6xl">
        Get In Touch
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-gray-500">
        Ready to elevate your supply chain? Contact us today for wholesale
        pricing, custom OEM solutions, and reliable technical support.
      </p>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div
        class="grid grid-cols-1 items-start gap-16 lg:grid-cols-2 lg:gap-20 xl:gap-24">
        <div data-aos="fade-right">
          <h2 class="mb-6 text-3xl font-bold text-[#0f172a] md:text-4xl">
            Contact Information
          </h2>
          <p class="mb-12 leading-relaxed text-gray-500">
            Our dedicated support team is available to assist you with any
            inquiries regarding our premium materials, shipping logistics, or
            B2B partnership policies.
          </p>

          <div
            class="mb-16 grid grid-cols-1 gap-y-10 sm:grid-cols-2 sm:gap-x-8">
            <div class="flex gap-4">
              <div
                class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-[#eff6ff] text-[#2563eb] transition-transform hover:scale-110">
                <svg
                  class="size-6"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z">
                  </path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z">
                  </path>
                </svg>
              </div>
              <div>
                <h3 class="mb-1 text-lg font-bold text-[#0f172a]">
                  Our Address
                </h3>
                <p class="text-sm leading-relaxed text-gray-500">
                  Aerosol Industrial Park, Economic Development Zone, Dacheng
                  County, Langfang City, Hebei Province, China
                </p>
              </div>
            </div>

            <div class="flex gap-4">
              <div
                class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-[#eff6ff] text-[#2563eb] transition-transform hover:scale-110">
                <svg
                  class="size-6"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.25-3.95-6.847-6.847l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z">
                  </path>
                </svg>
              </div>
              <div>
                <h3 class="mb-1 text-lg font-bold text-[#0f172a]">
                  Contact Number
                </h3>
                <p class="text-sm leading-relaxed text-gray-500">
                  +86 15909713999
                </p>
              </div>
            </div>

            <div class="flex gap-4">
              <div
                class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-[#eff6ff] text-[#2563eb] transition-transform hover:scale-110">
                <svg
                  class="size-6"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75">
                  </path>
                </svg>
              </div>
              <div>
                <h3 class="mb-1 text-lg font-bold text-[#0f172a]">
                  Email Address
                </h3>
                <p class="text-sm leading-relaxed text-gray-500">
                  jinlimei@kingsendainsulation.com
                </p>
              </div>
            </div>

            <div class="flex gap-4">
              <div
                class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-[#eff6ff] text-[#2563eb] transition-transform hover:scale-110">
                <svg
                  class="size-6"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z">
                  </path>
                </svg>
              </div>
              <div>
                <h3 class="mb-1 text-lg font-bold text-[#0f172a]">Our Time</h3>
                <p class="text-sm leading-relaxed text-gray-500">
                  Mon - Sat: 9:00 - 18:00 (GMT+8)<br />
                  Sunday: Closed
                </p>
              </div>
            </div>
          </div>

          <div>
            <h3 class="mb-4 text-xl font-bold text-[#0f172a]">
              Follow The Social Media:
            </h3>
            <p class="mb-6 text-sm text-gray-500">
              Stay updated with our latest products and factory news.
            </p>
            <div class="flex items-center gap-4">
              <a
                href="https://www.linkedin.com/company/124594020/admin/dashboard/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-all hover:-translate-y-1 hover:bg-[#eff6ff] hover:text-[#2563eb]"
                aria-label="LinkedIn">
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 fill-current"
                  xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z">
                  </path>
                </svg>
              </a>
              <a
                href="https://www.facebook.com/KingsendaInsulationMaterials/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-all hover:-translate-y-1 hover:bg-[#eff6ff] hover:text-[#2563eb]"
                aria-label="Facebook">
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 fill-current"
                  xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z">
                  </path>
                </svg>
              </a>
              <a
                href="https://www.youtube.com/@%E9%87%91%E6%A3%AE%E8%BE%BE"
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-all hover:-translate-y-1 hover:bg-[#eff6ff] hover:text-[#2563eb]"
                aria-label="YouTube">
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 fill-current"
                  xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z">
                  </path>
                </svg>
              </a>
              <a
                href="https://www.tiktok.com/@user4717696158156?is_from_webapp=1&sender_device=pc"
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-all hover:-translate-y-1 hover:bg-[#eff6ff] hover:text-[#2563eb]"
                aria-label="TikTok">
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 fill-current"
                  xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.06-2.89-.44-4.13-1.24-.15 2.23-.12 4.47-.13 6.71-.01 2.52-.7 5.15-2.6 6.94-1.93 1.84-4.8 2.37-7.29 1.63-2.66-.75-4.81-3.05-5.32-5.74-.59-2.92.51-6.14 2.91-7.94 1.71-1.31 4.02-1.8 6.13-1.39v4.1c-1.34-.35-2.88-.06-3.89.87-1.11 1.01-1.37 2.78-.66 4.1.66 1.34 2.27 2.11 3.73 1.83 1.17-.17 2.16-1.12 2.36-2.28.11-2.42.04-4.84.06-7.26V0l.25.02z">
                  </path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div data-aos="fade-up" data-aos-delay="100">
          <div
            class="theme-dark rounded-[2.5rem] bg-[#0f172a] p-8 shadow-2xl lg:p-12">
            <h2 class="mb-8 text-3xl font-bold text-white">Send Us Message</h2>

            {
              form ? (
                <div class="contact-form-wrapper">
                  <ContactForm form={form} />
                </div>
              ) : (
                <p class="text-red-500">Error: Contact form data not found.</p>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
