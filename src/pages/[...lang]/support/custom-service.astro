---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import config from ".astro/config.generated.json";
import { render } from "astro:content";
import CustomServiceHero from "@/components/sections/CustomServiceHero.astro";
import CustomServiceList from "@/components/sections/CustomServiceList.astro";
import CustomServiceProcess from "@/components/sections/CustomServiceProcess.astro";
import CustomServiceCase from "@/components/sections/CustomServiceCase.astro";
import CustomServiceFAQ from "@/components/sections/CustomServiceFAQ.astro";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang: any) => {
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;
      const pageData: any = await getEntryCTM(
        "pages" as any,
        "custom-service",
        lang.languageCode,
      );

      return {
        params: {
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
        },
        props: {
          pageData,
        },
      };
    }),
  );

  return paths.flat();
}

const { pageData } = Astro.props;
if (!pageData) return Astro.redirect("/404");
const { Content } = await render(pageData);
---

<Base {...pageData.data}>
  <CustomServiceHero />
  <CustomServiceList />
  <CustomServiceProcess />
  <CustomServiceCase />
  <CustomServiceFAQ />
</Base>
