---
import social from "@/config/social.json";
import Icons from "@/helpers/Icons.astro";
import { markdownify } from "@/lib/utils/textConverter";
import config from ".astro/config.generated.json";
import { useTranslations, getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import { filteredEnabled } from "@/lib/utils/filteredEnabled";

const t = await useTranslations(Astro.currentLocale as string);
let { copyright, footerDescription } = config.settings;

const siteTitle = config.site.title || "Kingsenda";

footerDescription = footerDescription || t("footerBlock.description");
const copyrightText = copyright.text;
---

<footer class="border-t border-gray-800 bg-gray-900">
  <div class="w-full px-6 md:px-12 lg:px-16">
    <div
      class="grid grid-cols-1 gap-10 py-16 md:grid-cols-2 lg:grid-cols-12 lg:gap-8 lg:py-24">
      <div class="flex flex-col lg:col-span-3">
        <h3 class="mb-6 text-3xl font-bold tracking-tight text-white">
          {siteTitle}
        </h3>
        <p class="mb-8 max-w-sm text-sm leading-relaxed text-gray-400">
          {footerDescription}
        </p>

        <div class="mt-auto flex items-center gap-4">
          {
            filteredEnabled(social.main).map((item: any) => (
              <a
                href={getLocaleUrlCTM(item.url as string, Astro.currentLocale)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
                class="group/social flex size-10 items-center justify-center rounded-full bg-gray-800 text-gray-400 transition-all duration-300 hover:bg-blue-600 hover:text-white">
                {item.label === "TikTok" ? (
                  <svg
                    class="size-4 fill-current"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg">
                    <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.06-2.89-.44-4.13-1.24-.15 2.23-.12 4.47-.13 6.71-.01 2.52-.7 5.15-2.6 6.94-1.93 1.84-4.8 2.37-7.29 1.63-2.66-.75-4.81-3.05-5.32-5.74-.59-2.92.51-6.14 2.91-7.94 1.71-1.31 4.02-1.8 6.13-1.39v4.1c-1.34-.35-2.88-.06-3.89.87-1.11 1.01-1.37 2.78-.66 4.1.66 1.34 2.27 2.11 3.73 1.83 1.17-.17 2.16-1.12 2.36-2.28.11-2.42.04-4.84.06-7.26V0l.25.02z" />
                  </svg>
                ) : (
                  <Icons icon={item.lucideIcon || "Link"} class="size-4" />
                )}
                <span class="sr-only">{item.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-2">
        <h4 class="mb-6 text-lg font-bold text-white">Products</h4>
        <ul class="flex flex-col gap-4">
          <li>
            <a
              href="/products/glass-wool-felt/"
              class="text-sm text-gray-400 transition-colors hover:text-blue-400">
              Glass Wool Felt
            </a>
          </li>
          <li>
            <a
              href="/products/rubber-plastic-pipe/"
              class="text-sm text-gray-400 transition-colors hover:text-blue-400">
              Rubber Plastic Pipe
            </a>
          </li>
          <li>
            <a
              href="/support/custom-service/"
              class="text-sm text-gray-400 transition-colors hover:text-blue-400">
              Custom Service (OEM)
            </a>
          </li>
          <li>
            <a
              href="/support/faq/"
              class="text-sm text-gray-400 transition-colors hover:text-blue-400">
              FAQs
            </a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h4 class="mb-6 text-lg font-bold text-white">Resources</h4>
        <ul class="flex flex-col gap-4">
          <li>
            <a
              href="/case/hvac-systems/"
              class="text-sm text-gray-400 transition-colors hover:text-blue-400">
              HVAC Systems
            </a>
          </li>
          <li>
            <a
              href="/case/industrial-piping/"
              class="text-sm text-gray-400 transition-colors hover:text-blue-400">
              Industrial Piping
            </a>
          </li>
          <li>
            <a
              href="/case/steel-structure/"
              class="text-sm text-gray-400 transition-colors hover:text-blue-400">
              Steel Structure
            </a>
          </li>
          <li>
            <a
              href="/support/shipping-logistics/"
              class="text-sm text-gray-400 transition-colors hover:text-blue-400">
              Global Shipping
            </a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h4 class="mb-6 text-lg font-bold text-white">About Us</h4>
        <ul class="flex flex-col gap-4">
          <li>
            <a
              href="/about/"
              class="text-sm text-gray-400 transition-colors hover:text-blue-400">
              About Factory
            </a>
          </li>
          <li>
            <a
              href="/warranty/"
              class="text-sm text-gray-400 transition-colors hover:text-blue-400">
              Warranty
            </a>
          </li>
          <li>
            <a
              href="/blog/"
              class="text-sm text-gray-400 transition-colors hover:text-blue-400">
              Blog & News
            </a>
          </li>
          <li>
            <a
              href="/contact/"
              class="text-sm text-gray-400 transition-colors hover:text-blue-400">
              Contact Us
            </a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h4 class="mb-6 text-lg font-bold text-white">
          {t("subscription.title")}
        </h4>
        <p class="mb-6 text-sm leading-relaxed text-gray-400">
          {t("subscription.description")}
        </p>
        <form
          class="flex flex-col gap-3"
          action={config.settings.subscription.formAction}
          method="POST">
          <div class="relative">
            <input
              type="email"
              name="email"
              placeholder={t("common.emailPlaceholder")}
              required
              class="w-full rounded-xl border border-gray-700 bg-gray-800 px-4 py-3.5 text-sm text-white transition-all placeholder:text-gray-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none"
            />
          </div>
          <button
            type="submit"
            class="flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-3.5 text-sm font-bold text-white transition-colors hover:bg-blue-700">
            Subscribe Now
            <Icons icon="ArrowRight" class="size-4" />
          </button>
        </form>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-between border-t border-gray-800 py-8 md:flex-row">
      {
        copyright.enable && (
          <div
            class="text-center text-sm text-gray-300 md:text-left"
            set:html={markdownify(
              t("footerBlock.copyright") || copyrightText,
              true,
            )}
          />
        )
      }

      <div class="mt-4 flex items-center gap-6 text-sm md:mt-0">
        <a
          href="/privacy-policy/"
          class="text-gray-300 transition-colors hover:text-white">
          Privacy Policy
        </a>
      </div>
    </div>
  </div>
</footer>
