---
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";

import { getEntryCTM } from "@/lib/contentParser.astro";

const sectionData = await getEntryCTM(
  "sections",
  "products-b2b-capabilities",
  Astro.currentLocale,
);

if (!sectionData || !sectionData.data.enable) return null;

const {
  title,
  subtitle,
  description,
  bgImage,
  portfolioCenterLabel,
  portfolioRightLabel,
  portfolioStatement,
  portfolioImages,
} = sectionData.data;
---

<div class="flex w-full flex-col">
  <section
    class="relative flex w-full justify-center overflow-hidden py-28 text-white shadow-[0_30px_60px_rgba(0,0,0,0.1)] lg:py-40">
    {
      bgImage && (
        <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden select-none">
          <OptimizedImage
            src={bgImage}
            alt="B2B Capabilities Background"
            class="h-full w-full object-cover object-center opacity-90 transition-opacity duration-500"
            width={1920}
            height={1080}
          />

          <div class="absolute inset-0 bg-black/25" />
        </div>
      )
    }

    <div
      class="relative z-10 flex w-full max-w-350 flex-col gap-12 px-6 md:px-12 lg:flex-row lg:items-end lg:justify-between lg:px-20">
      <div class="max-w-3xl" data-aos="fade-right">
        <span
          class="mb-6 block text-sm font-semibold tracking-[0.3em] text-white/90 uppercase drop-shadow-sm">
          {subtitle}
        </span>

        <h2
          class="text-5xl leading-[0.95] font-medium tracking-tight text-white drop-shadow-md md:text-7xl lg:text-[80px] xl:text-[90px]">
          {title}
        </h2>
      </div>

      <div class="max-w-xs" data-aos="fade-left">
        <p
          class="border-l-2 border-white/40 py-1 pl-6 text-base leading-relaxed font-medium text-white/90 drop-shadow-sm backdrop-blur-[2px]">
          {description}
        </p>
      </div>
    </div>
  </section>

  {
    portfolioStatement && (
      <section class="mt-2 flex w-full flex-col items-center overflow-hidden rounded-[2.5rem] bg-white pt-10 pb-16 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.02)] md:mt-3 md:pt-12 md:pb-24 lg:mt-4 lg:rounded-[4rem] lg:pt-16 lg:pb-32">
        <div class="relative mb-16 w-full max-w-350 px-6 md:mb-24 md:px-12 lg:mb-32 lg:px-20">
          <div
            class="relative mb-20 flex items-center justify-between text-[10px] font-medium tracking-[0.2em] text-black/80 uppercase md:mb-28 md:text-xs lg:mb-32"
            data-aos="fade-up">
            <div class="shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                stroke-linejoin="miter">
                <rect x="3" y="3" width="18" height="18" />

                <polygon points="12 7 13.2 10.5 17 10.5 14 12.5 15.2 16 12 14 8.8 16 10 12.5 7 10.5 10.8 10.5" />
              </svg>
            </div>

            <div class="absolute left-1/2 -translate-x-1/2 text-center whitespace-nowrap">
              {portfolioCenterLabel}
            </div>

            <div class="text-right font-mono tracking-widest">
              {portfolioRightLabel}
            </div>
          </div>

          <div
            class="mx-auto max-w-287.5 text-center"
            data-aos="fade-up"
            data-aos-delay="100">
            <h3 class="text-4xl leading-[1.15] font-medium tracking-tight text-black uppercase sm:text-5xl md:text-6xl lg:text-[72px] xl:text-[84px]">
              {portfolioStatement}
            </h3>
          </div>
        </div>

        {portfolioImages && portfolioImages.length >= 4 && (
          <div class="container-2xl w-full px-4 md:px-6 lg:px-8">
            <div class="grid auto-rows-[300px] grid-cols-1 gap-1 md:auto-rows-[400px] md:grid-cols-12 md:gap-2">
              <div
                class="group relative overflow-hidden rounded-2xl md:col-span-6 md:row-span-2 md:rounded-3xl"
                data-aos="zoom-in"
                data-aos-duration="1000">
                <OptimizedImage
                  src={portfolioImages[0].src}
                  alt={portfolioImages[0].alt}
                  class="h-full w-full object-cover transition-transform duration-[1.5s] group-hover:scale-105"
                  width={800}
                  height={1200}
                />
              </div>

              <div
                class="group relative overflow-hidden rounded-2xl md:col-span-6 md:row-span-1 md:rounded-3xl"
                data-aos="zoom-in"
                data-aos-delay="100"
                data-aos-duration="1000">
                <OptimizedImage
                  src={portfolioImages[1].src}
                  alt={portfolioImages[1].alt}
                  class="h-full w-full object-cover transition-transform duration-[1.5s] group-hover:scale-105"
                  width={800}
                  height={600}
                />
              </div>

              <div
                class="group relative overflow-hidden rounded-2xl md:col-span-3 md:row-span-1 md:rounded-3xl"
                data-aos="zoom-in"
                data-aos-delay="200"
                data-aos-duration="1000">
                <OptimizedImage
                  src={portfolioImages[2].src}
                  alt={portfolioImages[2].alt}
                  class="h-full w-full object-cover transition-transform duration-[1.5s] group-hover:scale-105"
                  width={400}
                  height={400}
                />
              </div>

              <div
                class="group relative overflow-hidden rounded-2xl md:col-span-3 md:row-span-1 md:rounded-3xl"
                data-aos="zoom-in"
                data-aos-delay="300"
                data-aos-duration="1000">
                <OptimizedImage
                  src={portfolioImages[3].src}
                  alt={portfolioImages[3].alt}
                  class="h-full w-full object-cover transition-transform duration-[1.5s] group-hover:scale-105"
                  width={400}
                  height={400}
                />
              </div>

              <div
                class="group relative overflow-hidden rounded-2xl md:col-span-4 md:row-span-1 md:rounded-3xl"
                data-aos="zoom-in"
                data-aos-duration="1000">
                <OptimizedImage
                  src={portfolioImages[4].src}
                  alt={portfolioImages[4].alt}
                  class="h-full w-full object-cover transition-transform duration-[1.5s] group-hover:scale-105"
                  width={600}
                  height={600}
                />
              </div>

              <div
                class="group relative overflow-hidden rounded-2xl md:col-span-8 md:row-span-1 md:rounded-3xl"
                data-aos="zoom-in"
                data-aos-delay="150"
                data-aos-duration="1000">
                <OptimizedImage
                  src={portfolioImages[5].src}
                  alt={portfolioImages[5].alt}
                  class="h-full w-full object-cover transition-transform duration-[1.5s] group-hover:scale-105"
                  width={1200}
                  height={600}
                />
              </div>
            </div>
          </div>
        )}
      </section>
    )
  }
</div>

<style>
  h2,
  h3,
  p {
    text-rendering: optimizeLegibility;

    -webkit-font-smoothing: antialiased;
  }
</style>
