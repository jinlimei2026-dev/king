---
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";

const sectionData = await getEntryCTM(
  "sections",
  "about-history",
  Astro.currentLocale,
);

if (!sectionData || !sectionData.data.enable) return null;

const { topBanner, header, historyGrid } = sectionData.data;
---

<section
  class="relative w-full overflow-hidden bg-white pt-10 pb-24 md:pt-16 md:pb-32">
  <div class="relative z-10 mx-auto max-w-375 px-6 lg:px-20">
    <div
      class="mb-24 flex h-auto flex-col gap-6 md:h-137.5 md:flex-row lg:mb-32 lg:h-162.5"
      data-aos="fade-up">
      <div
        class={`flex w-full flex-col justify-between rounded-4xl p-10 text-white shadow-sm md:w-1/3 lg:p-14 ${topBanner.leftCard.backgroundColor}`}>
        <div class="mb-12">
          <svg
            viewBox="0 0 100 100"
            class="h-14 w-14 text-white/80"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round">
            <line x1="50" y1="10" x2="50" y2="90"></line>
            <line x1="10" y1="50" x2="90" y2="50"></line>
            <line x1="22" y1="22" x2="78" y2="78"></line>
            <line x1="22" y1="78" x2="78" y2="22"></line>
            <line x1="30" y1="15" x2="70" y2="85"></line>
            <line x1="70" y1="15" x2="30" y2="85"></line>
            <line x1="15" y1="30" x2="85" y2="70"></line>
            <line x1="15" y1="70" x2="85" y2="30"></line>
          </svg>
        </div>
        <h3
          class="max-w-62.5 text-3xl leading-[1.1] font-medium tracking-tight text-white lg:text-4xl">
          {topBanner.leftCard.text}
        </h3>
      </div>

      <div
        class="h-100 w-full overflow-hidden rounded-4xl shadow-sm md:h-full md:w-2/3">
        <OptimizedImage
          src={topBanner.rightImage.src}
          alt={topBanner.rightImage.alt}
          class="h-full w-full object-cover"
          width={1200}
          height={800}
        />
      </div>
    </div>

    <div class="mb-20 lg:mb-28" data-aos="fade-up">
      <div class="mb-8 flex items-center gap-4">
        <span class="text-sm font-semibold tracking-wide text-gray-800">
          {header.subtitle}
        </span>
        <div class="h-px w-24 bg-gray-400"></div>
      </div>
      <h2
        class="max-w-3xl text-4xl leading-[1.15] font-medium tracking-tight text-gray-900 md:text-5xl lg:text-[56px]">
        {header.title}
      </h2>
    </div>

    <div class="relative w-full">
      <div
        class="relative z-10 grid w-full grid-cols-1 gap-x-12 gap-y-16 md:grid-cols-2 lg:w-[65%]"
        data-aos="fade-up"
        data-aos-delay="100">
        {
          historyGrid &&
            historyGrid.map((item: any) => (
              <div class="flex flex-col">
                <h4 class="mb-4 text-xl font-medium text-gray-900">
                  {item.year}
                </h4>
                <p class="max-w-[90%] text-sm leading-relaxed text-gray-500">
                  {item.description}
                </p>
              </div>
            ))
        }
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none absolute right-[-10%] bottom-[-10%] z-0 aspect-square w-150 overflow-hidden opacity-40 md:w-175 lg:w-225">
    <svg
      viewBox="0 0 200 200"
      class="h-full w-full text-[#cfcfcf]"
      fill="none"
      stroke="currentColor"
      stroke-width="16">
      <circle cx="200" cy="200" r="30"></circle>
      <circle cx="200" cy="200" r="70"></circle>
      <circle cx="200" cy="200" r="110"></circle>
      <circle cx="200" cy="200" r="150"></circle>
      <circle cx="200" cy="200" r="190"></circle>
    </svg>
  </div>
</section>
