---
import { getEntryCTM } from "@/lib/contentParser.astro";

const sectionData = await getEntryCTM(
  "sections",
  "warranty-policy",
  Astro.currentLocale,
);

if (!sectionData || !sectionData.data.enable) return null;

const {
  badge,
  title,
  description,
  highlight,
  coveredProducts,
  coverageDetails,
  resolution,
} = sectionData.data;
---

<section class="bg-white py-20 md:py-32">
  <div class="container mx-auto px-6 md:px-12 lg:px-20">
    <div
      class="flex flex-col gap-16 lg:flex-row lg:items-center lg:justify-between">
      <div class="w-full lg:w-5/12" data-aos="fade-right">
        <span
          class="mb-4 inline-block rounded-full bg-blue-50 px-4 py-1.5 text-sm font-bold tracking-widest text-[#2563eb] uppercase">
          {badge}
        </span>
        <h2
          class="mb-6 text-3xl font-extrabold tracking-tight text-[#0f172a] sm:text-4xl">
          {title}
        </h2>
        <p class="mb-10 text-lg leading-relaxed text-gray-600">
          {description}
        </p>

        <div
          class="rounded-3xl border border-gray-100 bg-[#f8f9fa] p-8 shadow-sm">
          <div class="flex items-baseline gap-2 text-[#2563eb]">
            <span class="text-7xl font-black tracking-tighter">
              {highlight.years}
            </span>
            <span class="text-xl font-bold uppercase">{highlight.label}</span>
          </div>
          <p class="mt-4 text-sm font-medium text-gray-500">
            * {highlight.text}
          </p>
        </div>
      </div>

      <div
        class="w-full rounded-3xl bg-[#0f172a] p-8 text-white shadow-2xl lg:w-6/12 lg:p-12"
        data-aos="fade-left">
        <div class="mb-10">
          <h3
            class="mb-5 border-b border-gray-700 pb-3 text-xl font-bold text-white">
            {coveredProducts.title}
          </h3>
          <ul class="space-y-3">
            {
              coveredProducts.items.map((item: string) => (
                <li class="flex items-start">
                  <i class="fa-solid fa-check mt-1 mr-3" />
                  <span class="text-gray-300">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mb-10">
          <h3
            class="mb-5 border-b border-gray-700 pb-3 text-xl font-bold text-white">
            {coverageDetails.title}
          </h3>
          <ul class="space-y-3">
            {
              coverageDetails.items.map((item: string) => (
                <li class="flex items-start">
                  <i class="fa-solid fa-shield-halved mt-1 mr-3 text-blue-400" />
                  <span class="text-gray-300">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-xl border border-blue-500/30 bg-blue-600/20 p-5">
          <h3 class="mb-2 text-lg font-bold text-blue-300">
            {resolution.title}
          </h3>
          <p class="text-sm leading-relaxed text-blue-100/80">
            {resolution.text}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
