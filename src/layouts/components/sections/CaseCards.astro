---
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
const { title, description, cases = [] } = Astro.props;
---

<section class="section bg-white py-64">
  <div class="container mx-auto px-4 md:px-8 lg:px-12">
    {
      title && (
        <div class="mb-16" data-aos="fade-up">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 md:text-5xl">
            {title}
          </h2>
          {description && (
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-600">
              {description}
            </p>
          )}
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-8">
      {
        cases.map((item: any, index: number) => (
          <div
            class="group flex w-full flex-col overflow-hidden rounded-3xl bg-[#F6F5F2] transition-shadow duration-300 hover:shadow-xl md:flex-row"
            data-aos="fade-up"
            data-aos-delay={index * 150}>
            <div class="flex w-full flex-col p-8 md:w-1/2 md:p-10">
              <div class="mb-6">
                <span class="inline-block rounded-full border border-gray-300 bg-transparent px-4 py-1 text-[10px] font-bold tracking-widest text-gray-500 uppercase">
                  {item.badge}
                </span>
              </div>

              <h3 class="mb-8 pr-4 text-2xl leading-snug font-bold text-gray-900 md:mb-0">
                {item.title}
              </h3>

              {item.button && item.button.label && (
                <div class="mt-auto pt-8">
                  <a
                    href={item.button.link || "#"}
                    class="inline-flex items-center rounded-full border border-gray-900 bg-gray-900 px-5 py-2 text-xs font-bold tracking-widest text-white uppercase transition-all hover:scale-105 hover:bg-gray-700 active:scale-95">
                    {item.button.label}
                  </a>
                </div>
              )}
            </div>

            <div class="relative min-h-75 w-full overflow-hidden bg-gray-200 md:min-h-90 md:w-1/2">
              {item.image ? (
                typeof item.image === "string" ? (
                  <img
                    src={item.image}
                    alt={item.title}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                ) : (
                  <OptimizedImage
                    src={item.image}
                    alt={item.title}
                    width={600}
                    height={800}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                )
              ) : (
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="text-sm text-gray-400">Image</span>
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
