---
import { getEntryCTM } from "@/lib/contentParser.astro";

const sectionData = await getEntryCTM(
  "sections",
  "products-faq",
  Astro.currentLocale,
);

if (!sectionData || !sectionData.data.enable) return null;
const { subtitle, title, description, buttonLabel, buttonUrl, questions } =
  sectionData.data;
---

<section
  class="flex w-full justify-center border-t border-gray-100 bg-white py-24 md:py-32 lg:py-40">
  <div class="container-2xl w-full px-6 md:px-12 lg:px-20">
    <div
      class="mb-20 flex w-full flex-col items-center text-center md:mb-28"
      data-aos="fade-up">
      <div class="mb-8">
        <span
          class="inline-block rounded-full border border-black/15 bg-black/5 px-4 py-1.5 text-[10px] font-bold tracking-[0.25em] text-black/70 uppercase">
          {subtitle}
        </span>
      </div>

      <h2
        class="mb-8 text-4xl leading-[1.1] font-black tracking-tighter text-black md:text-5xl lg:text-6xl">
        {title}
      </h2>

      <p
        class="max-w-2xl text-base leading-relaxed font-medium text-gray-500 md:text-lg">
        {description}
      </p>
    </div>

    <div
      class="grid grid-cols-1 gap-x-12 gap-y-8 md:grid-cols-2 lg:grid-cols-3 lg:gap-x-16"
      data-aos="fade-up"
      data-aos-delay="100">
      {
        questions &&
          questions.map((item: any) => (
            <details class="group h-fit border-b border-gray-200">
              <summary class="flex cursor-pointer list-none items-start justify-between py-6 outline-none">
                <h3 class="pr-6 text-base leading-tight font-bold text-gray-900 transition-colors group-hover:text-gray-600 md:text-lg">
                  {item.question}
                </h3>
                <div class="relative mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center">
                  <div class="h-0.5 w-full bg-black transition-transform duration-300 group-open:rotate-90" />
                  <div class="absolute h-full w-0.5 bg-black transition-transform duration-300 group-open:rotate-90" />
                </div>
              </summary>
              <div class="overflow-hidden transition-all duration-300">
                <p class="pb-8 text-sm leading-relaxed font-medium text-gray-500 md:text-base">
                  {item.answer}
                </p>
              </div>
            </details>
          ))
      }
    </div>

    {
      buttonLabel && buttonUrl && (
        <div class="mt-20 flex w-full justify-center" data-aos="fade-up">
          <a
            href={buttonUrl}
            class="group inline-flex items-center gap-3 border-b-2 border-transparent pb-1 text-sm font-bold text-black transition-all hover:border-black">
            <span>{buttonLabel}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform group-hover:translate-x-1">
              <>
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </>
            </svg>
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  h2,
  h3,
  p,
  span {
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  details[open] summary ~ * {
    animation: slideDown 0.3s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
