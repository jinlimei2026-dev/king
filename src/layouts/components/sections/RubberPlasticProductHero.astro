---
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import Button from "@/components/Button.astro";

const { title, subtitle, description, image, button1, button2, highlightTags } =
  Astro.props;

const colorMap: Record<
  string,
  { bg: string; text: string; border: string; shadow: string }
> = {
  cyan: {
    bg: "bg-[#00f0ff]/10",
    text: "text-[#00f0ff]",
    border: "hover:border-[#00f0ff]/50",
    shadow: "shadow-[inset_0_0_10px_rgba(0,240,255,0.2)]",
  },
  fuchsia: {
    bg: "bg-[#b5179e]/10",
    text: "text-[#b5179e]",
    border: "hover:border-[#b5179e]/50",
    shadow: "shadow-[inset_0_0_10px_rgba(181,23,158,0.2)]",
  },
  green: {
    bg: "bg-[#39ff14]/10",
    text: "text-[#39ff14]",
    border: "hover:border-[#39ff14]/50",
    shadow: "shadow-[inset_0_0_10px_rgba(57,255,20,0.2)]",
  },
};
---

<section
  class="relative flex min-h-[85vh] w-full items-center justify-start overflow-hidden bg-[#05050558] xl:min-h-[95vh]">
  <div class="absolute inset-0 -z-20">
    {
      image && (
        <OptimizedImage
          src={image}
          alt={title}
          width={1920}
          height={1080}
          class="h-full w-full scale-105 animate-[kenburns_30s_ease-in-out_infinite_alternate] object-cover object-center mix-blend-luminosity"
        />
      )
    }
  </div>

  <div class="relative z-10 container w-full pt-32 pb-16 lg:pb-24">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div
        class="hero-fade-up flex flex-col items-start gap-6 lg:col-span-8 lg:gap-8">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-[#00f0ff]/30 bg-[#00f0ff]/10 px-4 py-1.5 backdrop-blur-md">
          <span
            class="flex h-2 w-2 animate-pulse rounded-full bg-[#00f0ff] shadow-[0_0_8px_#00f0ff]">
          </span>
          <span
            class="text-sm font-bold tracking-[0.2em] text-[#00f0ff] uppercase">
            {subtitle}
          </span>
        </div>

        <h1
          class="max-w-4xl text-5xl leading-[1.1] font-black tracking-tighter text-white md:text-7xl lg:text-[80px]">
          {title}
        </h1>

        <p
          class="max-w-xl border-l-2 border-[#00f0ff]/30 py-1 pl-6 text-lg leading-relaxed font-medium text-white/60 md:text-xl">
          {description}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          {
            button1 && button1.enable && (
              <Button
                {...button1}
                class="inline-flex border-none bg-[#00f0ff] px-8 py-3.5 text-black shadow-lg shadow-[#00f0ff]/20 transition-all hover:-translate-y-1 hover:shadow-[#00f0ff]/40"
              />
            )
          }
          {
            button2 && button2.enable && (
              <Button
                {...button2}
                class="inline-flex border-white/20 px-8 py-3.5 text-white transition-transform hover:-translate-y-1 hover:bg-white/10"
              />
            )
          }
        </div>
      </div>

      <div
        class="hero-fade-up hero-delay-400 mt-10 flex flex-col gap-4 lg:col-span-4 lg:mt-0">
        {
          highlightTags &&
            highlightTags.map((tag: any) => {
              const theme = colorMap[tag.themeColor] || colorMap.cyan;
              return (
                <div
                  class={`group flex items-center gap-5 rounded-2xl border border-white/10 bg-black/40 p-5 backdrop-blur-xl transition-all hover:translate-x-2 ${theme.border}`}>
                  <div
                    class={`flex size-14 shrink-0 items-center justify-center rounded-xl ${theme.bg} ${theme.text} ${theme.shadow}`}>
                    <i class={`${tag.icon} text-2xl`} />
                  </div>
                  <div>
                    <p
                      class={`text-lg font-bold text-white transition-colors group-hover:${theme.text}`}>
                      {tag.title}
                    </p>
                    <p class="mt-1 text-xs font-semibold tracking-widest text-white/50 uppercase">
                      {tag.subtitle}
                    </p>
                  </div>
                </div>
              );
            })
        }
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes kenburns {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.15);
    }
  }

  .hero-fade-up {
    animation: customFadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-delay-400 {
    animation-delay: 0.4s;
  }

  @keyframes customFadeUp {
    0% {
      opacity: 0;
      transform: translateY(40px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
