---
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";

const sectionData = await getEntryCTM(
  "sections",
  "rubber-plastic-products-supply-chain",
  Astro.currentLocale,
);
if (!sectionData || !sectionData.data.enable) return null;

const { subtitle, title, description, production, certifications, packaging } =
  sectionData.data;
---

<section class="w-full bg-white py-24 md:py-32">
  <div class="mx-auto max-w-375 px-6 md:px-12 lg:px-20">
    <div
      class="mb-24 flex flex-col items-center gap-8 border-b border-gray-200 pb-16 text-center"
      data-aos="fade-up">
      <div class="flex flex-col items-center">
        <div class="mb-6 flex items-center gap-4">
          <span class="h-px w-8 bg-blue-600"></span>
          <span
            class="text-xs font-black tracking-[0.3em] text-blue-600 uppercase">
            {subtitle}
          </span>
          <span class="h-px w-8 bg-blue-600"></span>
        </div>
        <h2
          class="mb-8 text-6xl leading-[0.9] font-black tracking-tighter text-gray-900 md:text-[86px]">
          {title}
        </h2>
        <p class="max-w-2xl text-xl leading-relaxed font-medium text-gray-500">
          {description}
        </p>
      </div>
    </div>

    <div class="mb-32 grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        certifications.map((cert: any, index: number) => (
          <div
            class="group relative h-112.5 overflow-hidden rounded-4xl bg-white shadow-lg"
            data-aos="fade-up"
            data-aos-delay={index * 150}>
            <OptimizedImage
              src={cert.image}
              alt={cert.title}
              width={600}
              height={800}
              class="h-full w-full object-contain p-4 transition-transform duration-[2s] group-hover:scale-110"
            />

            <div class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-gray-900/90 to-transparent p-10">
              <span class="mb-4 text-5xl font-black text-white/20">
                {cert.stepNumber}
              </span>
              <h3 class="mb-2 text-2xl font-bold text-white">{cert.title}</h3>
              <p class="text-sm text-white/60">{cert.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <section class="mb-32 grid grid-cols-1 gap-16 text-left lg:grid-cols-2">
      <div class="flex flex-col justify-between">
        <div>
          <h3
            class="mb-8 flex w-full items-center text-4xl font-black text-gray-900">
            <span class="text-blue-600">
              <i class="fa-solid fa-industry"></i>
            </span>
            {production.title}
          </h3>
          <p class="mb-10 text-lg leading-relaxed text-gray-600">
            {production.description}
          </p>
          <div class="grid grid-cols-1 gap-6">
            {
              production.processDetails.map((detail: any) => (
                <div class="flex gap-4">
                  <div class="mt-1 text-blue-600">
                    <i class="fa-solid fa-circle-check" />
                  </div>
                  <div>
                    <h4 class="font-bold text-gray-900">{detail.title}</h4>
                    <p class="text-sm text-gray-500">{detail.text}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="mt-12">
          <a
            href={production.buttonUrl}
            class="inline-flex items-center gap-3 rounded-full bg-gray-900 px-10 py-4 font-bold text-white transition-colors hover:bg-blue-600">
            {production.buttonLabel}
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
      <div class="relative overflow-hidden rounded-4xl shadow-2xl">
        <OptimizedImage
          src={production.image}
          alt="Production"
          class="h-full w-full object-cover"
          width={800}
          height={600}
        />
      </div>
    </section>

    {
      packaging && (
        <section class="w-full">
          <div class="flex flex-col items-center gap-16 lg:flex-row">
            <div class="w-full lg:w-1/2" data-aos="fade-right">
              <div class="overflow-hidden rounded-4xl border border-gray-100 shadow-2xl">
                <OptimizedImage
                  src={packaging.image}
                  alt="Packaging"
                  class="h-137.5 w-full object-cover"
                  width={800}
                  height={600}
                />
              </div>
            </div>
            <div class="w-full lg:w-1/2" data-aos="fade-left">
              <div class="mb-12">
                <h2 class="mb-6 text-5xl font-black tracking-tighter text-gray-900">
                  {packaging.title}
                </h2>
                <div class="flex gap-4 font-medium text-gray-500">
                  <p class="flex-1 border-r border-gray-200 pr-6">
                    {packaging.intro1}
                  </p>
                  <p class="flex-1 pl-2">{packaging.intro2}</p>
                </div>
              </div>
              <div class="space-y-8">
                {packaging.list.map((item: any) => (
                  <div class="flex items-start gap-6 border-b border-gray-100 pb-8">
                    <span class="mt-1 text-3xl font-black text-blue-600">
                      {item.number}
                    </span>
                    <div>
                      <h3 class="mb-1 text-xl font-bold text-gray-900">
                        {item.title}
                      </h3>
                      <p class="text-sm leading-relaxed text-gray-500">
                        {item.description}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      )
    }
  </div>
</section>
