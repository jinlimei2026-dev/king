---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import { getEntryCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects";
import type { workingProcessSectionSchema } from "@/sections.schema";
import { markdownify } from "@/lib/utils/textConverter";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import SectionBadge from "../global/SectionBadge.astro";
import SectionTitle from "../global/SectionTitle.astro";
import Button from "@/components/Button.astro";

type SectionType = Section &
  NonNullable<z.infer<typeof workingProcessSectionSchema>>;
type Props = {
  content?: SectionType;
};

let defaultContent = (
  await getEntryCTM("sections", "working-process", Astro.currentLocale)
)?.data as SectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as SectionType;

const {
  enable = true,
  badge,
  title,
  image,
  list,
  button1,
  button2,
} = actualContent as any;

if (!enable) return;
---

<section class="relative overflow-hidden pt-0">
  <div
    class="container grid grid-cols-1 items-center lg:grid-cols-2 lg:gap-16 xl:gap-24">
    <div class="w-full py-10">
      {
        image && (
          <OptimizedImage
            src={image}
            alt={title}
            width={870}
            height={900}
            class="aspect-4/3 w-full overflow-hidden rounded-2xl object-cover shadow-lg lg:aspect-square lg:max-h-150 lg:rounded-3xl"
            data-aos="fade-right"
            data-aos-duration="800"
          />
        )
      }
    </div>

    <div class="flex w-full flex-col justify-center gap-6 lg:gap-8 lg:py-10">
      <div>
        {badge && <SectionBadge title={badge} />}
        {title && <SectionTitle title={title} />}
      </div>

      {
        list && list.length > 0 && (
          <div class="relative mt-4 flex flex-col">
            {list.map((item: any, i: number) => (
              <div
                class="relative flex items-start gap-5 pb-8 [clip-path:unset]! lg:gap-6 lg:pb-10"
                data-aos="fade-up"
                data-aos-delay={i * 100}
                data-aos-duration="600">
                {i !== list.length - 1 && (
                  <div class="border-primary absolute top-12 left-6 -ml-px h-full w-0 border-l-2 border-dashed lg:top-14 lg:left-8" />
                )}

                <div class="relative z-10 shrink-0">
                  <div
                    class:list={[
                      "flex size-12 items-center justify-center rounded-full text-white lg:size-16",
                      i === 0 ? "bg-primary" : "bg-theme-dark",
                    ]}>
                    {item.icon && (
                      <OptimizedImage
                        src={item.icon}
                        alt={item.title}
                        width={32}
                        height={32}
                        class="size-6 lg:size-8"
                        inlineSvg={true}
                      />
                    )}
                  </div>
                </div>

                <div class="pt-1 lg:pt-2">
                  <h3 class="text-h5 lg:text-h4-sm mb-2 font-semibold">
                    {item.title}
                  </h3>
                  <p
                    class="text-text-default/70 text-sm leading-relaxed md:text-base lg:max-w-md"
                    set:html={markdownify(item.description)}
                  />
                </div>
              </div>
            ))}

            <div
              class="mt-2 flex flex-wrap items-center gap-4 lg:mt-4"
              data-aos-delay={list.length * 100}>
              {button1 && button1.enable && (
                <Button {...button1} class="inline-flex px-8 py-3.5" />
              )}
              {button2 && button2.enable && (
                <Button {...button2} class="inline-flex px-8 py-3.5" />
              )}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
