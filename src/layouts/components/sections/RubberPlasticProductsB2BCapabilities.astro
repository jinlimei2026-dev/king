---
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";

const sectionData = await getEntryCTM(
  "sections",
  "rubber-plastic-products-b2b-capabilities",
  Astro.currentLocale,
);

if (!sectionData || !sectionData.data.enable) return null;

const {
  title,
  subtitle,
  description,
  portfolioCenterLabel,
  portfolioRightLabel,
  portfolioStatement,
  portfolioImages,
} = sectionData.data;
---

<section
  class="relative mt-24 w-full overflow-hidden bg-white py-24 md:py-32 lg:mt-32">
  <div class="mx-auto w-full max-w-375 px-6 md:px-12 lg:px-20">
    <div class="mb-20 w-full" data-aos="fade-up">
      <div
        class="mb-16 flex items-center justify-between border-b border-gray-200 pb-6 text-[10px] font-bold tracking-[0.2em] text-gray-400 uppercase">
        <div class="flex items-center gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-blue-600">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span>{portfolioCenterLabel}</span>
        </div>
        <span class="text-blue-600">{portfolioRightLabel}</span>
      </div>

      <div
        class="flex flex-col justify-between gap-12 lg:flex-row lg:items-end lg:gap-24">
        <div class="max-w-4xl" data-aos="fade-right">
          <span
            class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50 px-4 py-2 text-xs font-bold tracking-[0.3em] text-blue-600 uppercase">
            <span class="h-2 w-2 animate-pulse rounded-full bg-blue-600"></span>
            {subtitle}
          </span>
          <h2
            class="text-5xl leading-[1.05] font-black tracking-tighter text-gray-900 md:text-6xl lg:text-[76px]">
            {title}
          </h2>
        </div>

        <div class="max-w-md lg:pb-4" data-aos="fade-left">
          <p
            class="border-l-4 border-blue-600 pl-6 text-lg leading-relaxed font-medium text-gray-500 md:text-xl">
            {description}
          </p>
        </div>
      </div>
    </div>

    <div
      class="grid auto-rows-[280px] grid-cols-1 gap-4 md:auto-rows-[340px] md:grid-cols-4 md:gap-6">
      {
        portfolioImages && portfolioImages[0] && (
          <div
            class="group relative overflow-hidden rounded-4xl border border-gray-200/60 bg-gray-100 shadow-[0_8px_30px_rgba(0,0,0,0.02)] md:col-span-2 md:row-span-2"
            data-aos="fade-up">
            <OptimizedImage
              src={portfolioImages[0].src}
              alt={portfolioImages[0].alt}
              width={800}
              height={800}
              class="h-full w-full object-cover transition-all duration-[2s] group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/10 to-transparent opacity-60 transition-opacity group-hover:opacity-90" />

            <div class="absolute right-8 bottom-8 left-8 flex items-center justify-between">
              <span class="border-b border-white/50 pb-1 text-sm font-bold tracking-widest text-white uppercase">
                Manufacturing System
              </span>
              <div class="flex h-10 w-10 items-center justify-center rounded-full border border-white/40 bg-white/20 backdrop-blur-md transition-all group-hover:border-blue-600 group-hover:bg-blue-600">
                <i class="fa-solid fa-arrow-right -rotate-45 text-white" />
              </div>
            </div>
          </div>
        )
      }

      {
        portfolioImages && portfolioImages[1] && (
          <div
            class="group relative overflow-hidden rounded-4xl border border-gray-200/60 bg-gray-100 shadow-[0_8px_30px_rgba(0,0,0,0.02)] md:col-span-2 md:row-span-1"
            data-aos="fade-left"
            data-aos-delay="100">
            <OptimizedImage
              src={portfolioImages[1].src}
              alt={portfolioImages[1].alt}
              width={800}
              height={400}
              class="h-full w-full object-cover transition-all duration-[2s] group-hover:scale-110"
            />
          </div>
        )
      }

      <div
        class="relative flex flex-col justify-center overflow-hidden rounded-4xl border border-blue-100/50 bg-linear-to-br from-blue-50/80 to-white p-8 shadow-[0_8px_30px_rgba(0,0,0,0.02)] transition-all hover:shadow-[0_20px_40px_rgba(37,99,235,0.08)] md:col-span-1 md:row-span-1"
        data-aos="fade-up"
        data-aos-delay="200">
        <i
          class="fa-solid fa-quote-left relative z-10 mb-6 text-4xl text-blue-600/20">
        </i>
        <p
          class="relative z-10 text-[13px] leading-snug font-bold tracking-wide text-gray-900 uppercase md:text-sm">
          {portfolioStatement}
        </p>
      </div>

      {
        portfolioImages && portfolioImages[2] && (
          <div
            class="group relative overflow-hidden rounded-4xl border border-gray-200/60 bg-gray-100 shadow-[0_8px_30px_rgba(0,0,0,0.02)] md:col-span-1 md:row-span-1"
            data-aos="fade-left"
            data-aos-delay="300">
            <OptimizedImage
              src={portfolioImages[2].src}
              alt={portfolioImages[2].alt}
              width={400}
              height={400}
              class="h-full w-full object-cover transition-all duration-[2s] group-hover:scale-110"
            />
          </div>
        )
      }

      {
        portfolioImages && portfolioImages[3] && (
          <div
            class="group relative overflow-hidden rounded-4xl border border-gray-200/60 bg-gray-100 shadow-[0_8px_30px_rgba(0,0,0,0.02)] md:col-span-2 md:row-span-1"
            data-aos="fade-up">
            <OptimizedImage
              src={portfolioImages[3].src}
              alt={portfolioImages[3].alt}
              width={800}
              height={400}
              class="h-full w-full object-cover transition-all duration-[2s] group-hover:scale-110"
            />
          </div>
        )
      }

      {
        portfolioImages && portfolioImages[4] && (
          <div
            class="group relative overflow-hidden rounded-4xl border border-gray-200/60 bg-gray-100 shadow-[0_8px_30px_rgba(0,0,0,0.02)] md:col-span-2 md:row-span-1"
            data-aos="fade-up"
            data-aos-delay="100">
            <OptimizedImage
              src={portfolioImages[4].src}
              alt={portfolioImages[4].alt}
              width={800}
              height={400}
              class="h-full w-full object-cover transition-all duration-[2s] group-hover:scale-110"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
