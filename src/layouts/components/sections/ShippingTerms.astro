---
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";

const sectionData = await getEntryCTM(
  "sections",
  "shipping-terms",
  Astro.currentLocale,
);

if (!sectionData || !sectionData.data.enable) return null;

const {
  headerImage,
  subtitle,
  title,
  description,
  buttonLabel,
  buttonUrl,
  highlights,
  services,
  timeline,
} = sectionData.data;
---

<section class="w-full overflow-hidden bg-white pb-24 md:pb-32">
  <div
    class="relative mb-24 w-full overflow-hidden bg-[#0a1128]"
    data-aos="fade-up">
    <div class="absolute inset-0 z-0">
      <OptimizedImage
        src={headerImage}
        alt="Why Choose Us"
        class="h-full w-full object-cover opacity-65"
        width={1920}
        height={1000}
      />
      <div
        class="absolute inset-0 bg-linear-to-r from-[#0a1128]/70 via-[#0a1128]/30 to-transparent">
      </div>
    </div>

    <div
      class="relative z-10 mx-auto flex w-full max-w-375 flex-col items-center gap-16 px-6 py-32 md:py-48 lg:flex-row lg:gap-12 lg:px-20">
      <div class="w-full lg:w-7/12">
        <div class="mb-6 flex items-center gap-4">
          <span
            class="text-sm font-bold tracking-[0.15em] text-[#3b82f6] uppercase">
            {subtitle}
          </span>
          <div class="h-0.5 w-12 bg-[#3b82f6]"></div>
        </div>

        <h2
          class="mb-6 text-4xl leading-[1.15] font-bold text-white md:text-5xl lg:text-[54px]">
          {title}
        </h2>

        <p class="mb-10 max-w-xl text-lg leading-relaxed text-gray-200">
          {description}
        </p>

        <a
          href={buttonUrl}
          class="inline-flex items-center gap-3 rounded-full bg-[#2563eb] px-8 py-4 font-bold text-white shadow-lg shadow-blue-500/20 transition-all duration-300 hover:bg-[#1d4ed8]">
          {buttonLabel}
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <div class="mx-4 hidden h-64 w-px bg-white/10 lg:block"></div>

      <div class="flex w-full flex-col gap-10 lg:w-4/12">
        {
          highlights.map((hl: any) => (
            <div class="flex flex-col">
              <div class="mb-4">
                <i class={`${hl.icon} text-[28px] text-[#3b82f6]`} />
              </div>
              <h3 class="mb-3 text-xl font-bold text-white">{hl.title}</h3>
              <p class="text-sm leading-relaxed text-gray-300">
                {hl.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-375 px-6 lg:px-20">
    <div class="mb-32 grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        services.map((service: any, index: number) => (
          <div
            class="group overflow-hidden rounded-3xl border border-gray-100 bg-[#f8f9fa] transition-all duration-500 hover:border-[#2563eb]/20 hover:bg-white hover:shadow-2xl"
            data-aos="fade-up"
            data-aos-delay={index * 100}>
            <div class="relative h-96 w-full overflow-hidden">
              <OptimizedImage
                src={service.image}
                alt={service.title}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                width={600}
                height={600}
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/10 to-transparent" />
            </div>

            <div class="p-8 md:p-10">
              <h3 class="mb-4 text-2xl font-bold text-[#0f172a] transition-colors group-hover:text-[#2563eb]">
                {service.title}
              </h3>
              <p class="leading-relaxed text-gray-500">{service.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="relative mt-10 w-full" data-aos="fade-up">
      <div
        class="absolute top-7 right-[10%] left-[10%] z-0 hidden h-0.5 bg-linear-to-r from-transparent via-gray-200 to-transparent md:block">
      </div>

      <div
        class="relative z-10 grid grid-cols-1 gap-12 md:grid-cols-4 md:gap-6">
        {
          timeline.map((item: any, index: number) => (
            <div class="group relative flex flex-col items-start text-left md:items-center md:text-center">
              {index !== timeline.length - 1 && (
                <div class="absolute top-15 -bottom-15 left-7 z-0 w-0.5 bg-gray-100 md:hidden" />
              )}

              <div class="relative z-10 mb-6 flex h-14 w-14 items-center justify-center rounded-full border-4 border-[#f8f9fa] bg-white shadow-md transition-colors duration-300 group-hover:border-[#2563eb]/30">
                <span class="text-sm font-bold text-[#2563eb]">
                  {item.step}
                </span>
              </div>

              <div class="pl-20 md:pl-0" />

              <div class="absolute top-1 left-20 flex flex-col md:static md:top-auto md:left-auto md:items-center">
                <div class="mb-3 inline-block rounded-full bg-[#eff6ff] px-3 py-1 text-xs font-bold tracking-wider text-[#2563eb] uppercase">
                  {item.time}
                </div>
                <h4 class="mb-3 text-xl font-bold text-[#0f172a]">
                  {item.title}
                </h4>
                <p class="max-w-65 text-sm leading-relaxed text-gray-500">
                  {item.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
