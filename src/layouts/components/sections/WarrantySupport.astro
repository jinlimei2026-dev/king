---
import { getEntryCTM } from "@/lib/contentParser.astro";

const sectionData = await getEntryCTM(
  "sections",
  "warranty-support",
  Astro.currentLocale,
);

if (!sectionData || !sectionData.data.enable) return null;

const { title, description, steps } = sectionData.data;
---

<section class="bg-[#f8f9fa] py-24">
  <div class="container mx-auto px-6 md:px-12 lg:px-20">
    <div class="mb-16 text-center" data-aos="fade-up">
      <h2 class="text-3xl font-extrabold text-[#0f172a] sm:text-4xl">
        {title}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-gray-600">{description}</p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        steps.map((step: any, index: number) => (
          <div
            class="relative rounded-2xl border border-gray-100 bg-white p-8 shadow-sm transition-all hover:shadow-lg"
            data-aos="fade-up"
            data-aos-delay={index * 150}>
            <div class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-600 text-2xl font-black text-white shadow-lg shadow-blue-200">
              {String(index + 1).padStart(2, "0")}
            </div>

            <h3 class="mb-4 text-xl font-bold text-[#0f172a]">{step.title}</h3>
            <p class="text-sm leading-relaxed text-gray-600">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
