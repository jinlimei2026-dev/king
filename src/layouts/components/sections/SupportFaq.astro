---
const { title, description, faqs = [] } = Astro.props;
---

<section class="bg-white py-32">
  <div class="container mx-auto max-w-4xl px-6 md:px-12">
    <div class="mb-16 text-center" data-aos="fade-up">
      {
        title && (
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 md:text-5xl">
            {title}
          </h2>
        )
      }
      {description && <p class="mt-6 text-lg text-gray-600">{description}</p>}
    </div>

    <div
      class="divide-y divide-gray-200 border-t border-b border-gray-200"
      data-aos="fade-up"
      data-aos-delay="100">
      {
        faqs.map((faq: any) => (
          <details class="group py-6 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between text-left font-bold text-gray-900 transition-colors hover:text-blue-600 md:text-xl">
              <span class="pr-6">{faq.question}</span>
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gray-300 bg-white transition-all duration-300 group-open:rotate-180 group-open:border-gray-900 group-open:bg-gray-900 group-open:text-white">
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </span>
            </summary>

            <div class="mt-6 pr-12 text-base leading-relaxed text-gray-600 md:text-lg">
              {faq.answer}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
