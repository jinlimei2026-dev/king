---
import { getEntryCTM } from "@/lib/contentParser.astro";

const sectionData = await getEntryCTM(
  "sections",
  "custom-service-list",
  Astro.currentLocale,
);

if (!sectionData || !sectionData.data.enable) return null;

const { services } = sectionData.data;
---

<section class="w-full bg-white pb-24 md:pb-32">
  <div class="mx-auto max-w-375 px-6 lg:px-20">
    <div
      class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:gap-8 lg:grid-cols-4"
      data-aos="fade-up">
      {
        services &&
          services.map((service: any, index: number) => (
            <div
              class="flex h-full flex-col rounded-4xl bg-[#f8f9fa] p-8 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl md:p-10"
              data-aos="fade-up"
              data-aos-delay={index * 50}>
              <div class="mb-8 text-3xl text-[#2563eb]">
                <i class={service.icon} />
              </div>

              <h3 class="mb-4 text-xl font-bold tracking-tight text-gray-900">
                {service.title}
              </h3>

              <p class="text-sm leading-relaxed font-medium text-gray-500">
                {service.description}
              </p>
            </div>
          ))
      }
    </div>
  </div>
</section>
