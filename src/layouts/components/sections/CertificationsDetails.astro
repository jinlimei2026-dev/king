---
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";

const sectionData = await getEntryCTM(
  "sections",
  "certifications-details",
  Astro.currentLocale,
);

if (!sectionData || !sectionData.data.enable) return null;

const { title, subtitle, certificates } = sectionData.data;
---

<section class="bg-gray-50/30 py-24">
  <div class="container mx-auto px-6 md:px-12 lg:px-20">
    <div class="mb-16 text-center" data-aos="fade-up">
      <h2
        class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
        {title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        certificates &&
          certificates.map((cert: any, index: number) => (
            <div
              class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-gray-100 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl"
              data-aos="fade-up"
              data-aos-delay={index * 100}>
              <div class="mb-8 flex aspect-3/4 w-full items-center justify-center overflow-hidden rounded-2xl bg-gray-50 p-4 transition-colors group-hover:bg-blue-50/40">
                {cert.image ? (
                  <OptimizedImage
                    src={cert.image}
                    alt={cert.title}
                    width={300}
                    height={420}
                    class="max-h-full max-w-full object-contain transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <span class="text-sm text-gray-300">Image Placeholder</span>
                )}
              </div>

              <div class="flex grow flex-col">
                {cert.badge && (
                  <div class="mb-4">
                    <span class="inline-block rounded-full bg-blue-50 px-3 py-1 text-xs font-bold tracking-wider text-blue-600 uppercase">
                      {cert.badge}
                    </span>
                  </div>
                )}
                <h3 class="mb-3 text-xl leading-snug font-bold text-gray-900">
                  {cert.title}
                </h3>
                <p class="text-sm leading-relaxed text-gray-600">
                  {cert.description}
                </p>
              </div>
            </div>
          ))
      }
    </div>
  </div>
</section>
